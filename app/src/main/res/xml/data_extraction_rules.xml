<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude personal location database from Google Drive cloud backups -->
        <exclude domain="database" path="user_data.db" />
        <exclude domain="database" path="transit_stops.db" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude personal location database from USB/ADB device transfers -->
        <exclude domain="database" path="user_data.db" />
        <exclude domain="database" path="transit_stops.db" />
    </device-transfer>
</data-extraction-rules>
